<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <material name="orange">
    <color rgba="0.95 0.32 0.04 1"/>
  </material>

  <xacro:macro name="rev_joint" params="name type axis_xyz origin_rpy origin_xyz parent child effort velocity damping friction upper lower">
    <joint name="${name}" type="${type}">
      <axis xyz="${axis_xyz}" />
      <origin rpy="${origin_rpy}" xyz="${origin_xyz}" />
      <parent link="${parent}" />
      <child link="${child}" />
      <limit effort="${effort}" velocity="${velocity}" lower="${lower}" upper="${upper}"/>
      <dynamics damping="${damping}" friction="${friction}" />
    </joint>
  </xacro:macro>

  <xacro:macro name="frame_joint" params="name type origin_rpy origin_xyz parent child">
    <joint name="${name}" type="${type}">
      <origin rpy="${origin_rpy}" xyz="${origin_xyz}" />
      <parent link="${parent}" />
      <child link="${child}" />
    </joint>
  </xacro:macro>

  <xacro:macro name="mesh_link" params="name origin_xyz origin_rpy meshfile meshscale c_xyz matname mass i_xyz i_rpy length width height">
    <link name="${name}">
      <visual>
        <origin rpy="${origin_rpy}" xyz="${origin_xyz}" />
        <geometry>
          <mesh filename="${meshfile}" scale="${meshscale}"/>
        </geometry>
        <material name="${matname}"/>
      </visual>

      <inertial>
        <mass value="${mass}" />
        <origin rpy="${i_rpy}" xyz="${i_xyz}" /> <!-- Inertial Axes -->
        <inertia ixx="${mass * (width * width + height * height)/12.0}" ixy="${0}" ixz="${0}" iyx="${0}" iyy="${mass * (length * length + height * height)/12.0}" iyz="${0}" izx="${0}" izy="${0}" izz="${mass * (length * length + width * width)/12.0}" />
      </inertial>
    </link>
    <gazebo reference="${name}">
        <!-- These imported meshes remain visual-only because their legacy
             collision frames are not yet validated. Gravity remains enabled so
             the feet support the weight of the complete articulated robot. -->
        <gravity>true</gravity>
        <collide_bitmask>0x0</collide_bitmask>
        <xacro:if value="${matname == 'black'}">
          <material>Gazebo/Black</material>
        </xacro:if>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="mesh_link_sphere" params="name origin_xyz origin_rpy meshfile meshscale c_xyz matname mass i_xyz i_rpy length width height radius">
    <link name="${name}">
      <visual>
        <origin rpy="${origin_rpy}" xyz="${origin_xyz}" />
        <geometry>
          <mesh filename="${meshfile}" scale="${meshscale}"/>
        </geometry>
        <material name="${matname}"/>
      </visual>

      <collision>
        <!-- The source foot meshes contain robot-frame coordinates.  Using
             them as collision geometry again inside the foot link applies
             the frame offset twice and launches the model on contact. -->
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <sphere radius="${radius}" />
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <inertial>
        <mass value="${mass}" />
        <origin rpy="${i_rpy}" xyz="${i_xyz}" /> <!-- Inertial Axes -->
        <inertia ixx="${mass * (width * width + height * height)/12.0}" ixy="${0}" ixz="${0}" iyx="${0}" iyy="${mass * (length * length + height * height)/12.0}" iyz="${0}" izx="${0}" izy="${0}" izz="${mass * (length * length + width * width)/12.0}" />
      </inertial>
    </link>

    <gazebo reference="${name}">
      <gravity>true</gravity>
      <collide_bitmask>0xFFFF</collide_bitmask>
      <!-- Keep the foot penalty contact soft enough for the 1 ms ODE step. -->
      <kp>1000.0</kp>
      <kd>100.0</kd>
      <mu1>1.0</mu1>
      <mu2>0.1</mu2>
      <maxVel>0.02</maxVel>
      <minDepth>0.0001</minDepth>
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>


  <!-- Left Leg: prefix is front or rear -->
<!--   <xacro:macro name="LeftLeg" params="prefix reflect">
    <link name="${prefix}_Left_Leg">
        <visual>
            <geometry>
                <box size="${leglen} 0.1 0.2"/>
            </geometry>
            <origin xyz="0 0 -${leglen/2}" rpy="0 ${pi/2} 0"/>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="${leglen} 0.1 0.2"/>
            </geometry>
            <origin xyz="0 0 -${leglen/2}" rpy="0 ${pi/2} 0"/>
        </collision>
        <xacro:default_inertial mass="10"/>
    </link>

    <joint name="base_to_${prefix}_leg" type="fixed">
        <parent link="base_link"/>
        <child link="${prefix}_leg"/>
        <origin xyz="0 ${reflect*(width+.02)} 0.25" />
    </joint>
</xacro:macro> -->

</robot>
